# How the app signs people in.
#   mock: demo accounts and Quick Login, no backend needed (default)
#   api:  Laravel Sanctum SPA login against API_URL
AUTH_MODE=mock

# Laravel backend (kirei-be). Only read when AUTH_MODE=api.
API_URL=http://localhost:8000

# Origin this app is served from. Sanctum only treats a request as stateful when it comes from a
# domain listed in SANCTUM_STATEFUL_DOMAINS, so the server sends this as Origin and Referer.
FRONTEND_URL=http://localhost:3000

# Name of Laravel's session cookie: SESSION_COOKIE in kirei-be, or APP_NAME slugified with "_session".
SESSION_COOKIE_NAME=kirei_session
